{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DeepHUD",
  "version": "1.0.0",
  "identifier": "com.deepworkhud.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:deepwork-hud.db"]
    }
  },
  "app": {
    "windows": [
      {
        "label": "hud",
        "title": "DeepHUD",
        "width": 340,
        "height": 286,
        "minWidth": 230,
        "minHeight": 78,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost ws://localhost:1420 http://localhost:1420; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "A private, distraction-free deep-work timer",
    "longDescription": "DeepHUD is a privacy-first floating focus timer with Pomodoro intervals, local statistics, project tracking, and no cloud account or telemetry.",
    "copyright": "Copyright © 2026 Thilina Jayaranga",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
